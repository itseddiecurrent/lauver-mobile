generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ServiceMetadata {
  key       String   @id @db.VarChar(100)
  value     String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("service_metadata")
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum AuthProvider {
  EMAIL
}

enum EmailTokenPurpose {
  PASSWORD_RESET
}

model User {
  id          String         @id @default(uuid()) @db.Uuid
  status      UserStatus     @default(ACTIVE)
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")
  identities  AuthIdentity[]
  sessions    Session[]
  emailTokens EmailToken[]

  @@map("users")
}

model AuthIdentity {
  id                 String              @id @default(uuid()) @db.Uuid
  userId             String              @map("user_id") @db.Uuid
  provider           AuthProvider
  providerSubject    String              @map("provider_subject") @db.VarChar(320)
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  passwordCredential PasswordCredential?

  @@unique([provider, providerSubject])
  @@index([userId])
  @@map("auth_identities")
}

model PasswordCredential {
  identityId  String       @id @map("identity_id") @db.Uuid
  passwordHash String      @map("password_hash")
  changedAt   DateTime     @default(now()) @map("changed_at")
  identity    AuthIdentity @relation(fields: [identityId], references: [id], onDelete: Cascade)

  @@map("password_credentials")
}

model Session {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  refreshTokenHash String    @unique @map("refresh_token_hash") @db.Char(64)
  expiresAt        DateTime  @map("expires_at")
  lastUsedAt       DateTime? @map("last_used_at")
  revokedAt        DateTime? @map("revoked_at")
  compromisedAt    DateTime? @map("compromised_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model EmailToken {
  id        String            @id @default(uuid()) @db.Uuid
  userId    String            @map("user_id") @db.Uuid
  purpose   EmailTokenPurpose
  tokenHash String            @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime          @map("expires_at")
  usedAt    DateTime?         @map("used_at")
  createdAt DateTime          @default(now()) @map("created_at")
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@index([expiresAt])
  @@map("email_tokens")
}
