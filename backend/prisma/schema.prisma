generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ServiceMetadata {
  key       String   @id @db.VarChar(100)
  value     String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("service_metadata")
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum AuthProvider {
  EMAIL
  APPLE
}

enum EmailTokenPurpose {
  PASSWORD_RESET
}

model User {
  id            String               @id @default(uuid()) @db.Uuid
  status        UserStatus           @default(ACTIVE)
  createdAt     DateTime             @default(now()) @map("created_at")
  updatedAt     DateTime             @updatedAt @map("updated_at")
  identities    AuthIdentity[]
  sessions      Session[]
  emailTokens   EmailToken[]
  profile       Profile?
  sports        UserSport[]
  trainingTimes TrainingTime[]
  photoUploads  ProfilePhotoUpload[]
  outgoingBlocks Block[] @relation("Blocker")
  incomingBlocks Block[] @relation("Blocked")
  submittedReports Report[] @relation("Reporter")
  targetedReports Report[] @relation("ReportTarget")
  safetyActions SafetyAuditEvent[] @relation("SafetyActor")
  safetyTargets SafetyAuditEvent[] @relation("SafetyTarget")
  stravaConnection StravaConnection?
  stravaOAuthState StravaOAuthState?

  @@map("users")
}

model StravaConnection {
  userId String @id @map("user_id") @db.Uuid
  status String @db.VarChar(30)
  athleteId String @map("athlete_id") @db.VarChar(30)
  athleteName String @map("athlete_name") @db.VarChar(201)
  scopes String @db.VarChar(500)
  accessTokenEncrypted String @map("access_token_encrypted")
  refreshTokenEncrypted String @map("refresh_token_encrypted")
  expiresAt BigInt @map("expires_at")
  lastSyncedAt DateTime? @map("last_synced_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(3)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  activities StravaActivity[]
  @@index([status])
  @@map("strava_connections")
}

model StravaOAuthState {
  stateHash String @id @map("state_hash") @db.VarChar(64)
  userId String @unique @map("user_id") @db.Uuid
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([expiresAt])
  @@map("strava_oauth_states")
}

model StravaActivity {
  userId String @map("user_id") @db.Uuid
  providerActivityId String @map("provider_activity_id") @db.VarChar(30)
  title String @db.VarChar(500)
  sport String @db.VarChar(80)
  startedAt DateTime @map("started_at") @db.Timestamptz(3)
  durationSeconds Int @map("duration_seconds")
  distanceMeters Float @map("distance_meters")
  connection StravaConnection @relation(fields: [userId], references: [userId], onDelete: Cascade)
  @@id([userId, providerActivityId])
  @@index([userId, startedAt])
  @@map("strava_activities")
}

model Report {
  id String @id @default(uuid()) @db.Uuid
  reporterId String? @map("reporter_id") @db.Uuid
  targetUserId String? @map("target_user_id") @db.Uuid
  targetType String @map("target_type") @db.VarChar(20)
  source String @db.VarChar(20)
  reason String @db.VarChar(30)
  details String? @db.VarChar(2000)
  status String @default("open") @db.VarChar(20)
  snapshot Json
  requestId String @map("request_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  reporter User? @relation("Reporter", fields: [reporterId], references: [id], onDelete: SetNull)
  targetUser User? @relation("ReportTarget", fields: [targetUserId], references: [id], onDelete: SetNull)
  @@index([status, createdAt])
  @@index([targetUserId])
  @@map("reports")
}

model SafetyAuditEvent {
  id String @id @default(uuid()) @db.Uuid
  actorId String? @map("actor_id") @db.Uuid
  targetId String? @map("target_id") @db.Uuid
  action String @db.VarChar(30)
  reportId String? @map("report_id") @db.Uuid
  requestId String @map("request_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  actor User? @relation("SafetyActor", fields: [actorId], references: [id], onDelete: SetNull)
  target User? @relation("SafetyTarget", fields: [targetId], references: [id], onDelete: SetNull)
  @@index([actorId, createdAt])
  @@map("safety_audit_events")
}

model Profile {
  userId        String   @id @map("user_id") @db.Uuid
  displayName   String?  @map("display_name") @db.VarChar(80)
  bio           String?  @db.VarChar(500)
  photoKey      String?  @map("photo_key") @db.VarChar(512)
  cityName      String?  @map("city_name") @db.VarChar(120)
  regionCode    String?  @map("region_code") @db.VarChar(16)
  countryCode   String?  @map("country_code") @db.Char(2)
  cityLatitude  Decimal? @map("city_latitude") @db.Decimal(9, 6)
  cityLongitude Decimal? @map("city_longitude") @db.Decimal(9, 6)
  isComplete    Boolean  @default(false) @map("is_complete")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([isComplete])
  @@map("profiles")
}

model UserSport {
  userId      String   @map("user_id") @db.Uuid
  sport       String   @db.VarChar(32)
  paceValue   Decimal? @map("pace_value") @db.Decimal(9, 6)
  paceUnit    String?  @map("pace_unit") @db.VarChar(20)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, sport])
  @@index([sport, paceValue])
  @@map("user_sports")
}

model TrainingTime {
  userId     String   @map("user_id") @db.Uuid
  weekday    Int      @db.SmallInt
  timeBucket String   @map("time_bucket") @db.VarChar(16)
  createdAt  DateTime @default(now()) @map("created_at")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, weekday, timeBucket])
  @@map("training_times")
}

model PhotoCleanupJob {
  objectKey   String   @id @map("object_key") @db.VarChar(512)
  attempts    Int      @default(0)
  nextAttempt DateTime @default(now()) @map("next_attempt")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([nextAttempt])
  @@map("photo_cleanup_jobs")
}

model ProfilePhotoUpload {
  objectKey   String   @id @map("object_key") @db.VarChar(512)
  userId      String   @map("user_id") @db.Uuid
  contentType String   @map("content_type") @db.VarChar(32)
  byteSize    Int      @map("byte_size")
  expiresAt   DateTime @map("expires_at")
  createdAt   DateTime @default(now()) @map("created_at")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("profile_photo_uploads")
}

model AuthIdentity {
  id                 String              @id @default(uuid()) @db.Uuid
  userId             String              @map("user_id") @db.Uuid
  provider           AuthProvider
  providerSubject    String              @map("provider_subject") @db.VarChar(320)
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  passwordCredential PasswordCredential?
  appleCredential    AppleCredential?

  @@unique([provider, providerSubject])
  @@index([userId])
  @@map("auth_identities")
}

model AppleCredential {
  identityId            String       @id @map("identity_id") @db.Uuid
  email                 String?      @db.VarChar(320)
  givenName             String?      @map("given_name") @db.VarChar(100)
  familyName            String?      @map("family_name") @db.VarChar(100)
  refreshTokenEncrypted String       @map("refresh_token_encrypted")
  createdAt             DateTime     @default(now()) @map("created_at")
  updatedAt             DateTime     @updatedAt @map("updated_at")
  identity              AuthIdentity @relation(fields: [identityId], references: [id], onDelete: Cascade)

  @@map("apple_credentials")
}

model PasswordCredential {
  identityId   String       @id @map("identity_id") @db.Uuid
  passwordHash String       @map("password_hash")
  changedAt    DateTime     @default(now()) @map("changed_at")
  identity     AuthIdentity @relation(fields: [identityId], references: [id], onDelete: Cascade)

  @@map("password_credentials")
}

model Session {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  refreshTokenHash String    @unique @map("refresh_token_hash") @db.Char(64)
  expiresAt        DateTime  @map("expires_at")
  lastUsedAt       DateTime? @map("last_used_at")
  revokedAt        DateTime? @map("revoked_at")
  compromisedAt    DateTime? @map("compromised_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model EmailToken {
  id        String            @id @default(uuid()) @db.Uuid
  userId    String            @map("user_id") @db.Uuid
  purpose   EmailTokenPurpose
  tokenHash String            @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime          @map("expires_at")
  usedAt    DateTime?         @map("used_at")
  createdAt DateTime          @default(now()) @map("created_at")
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@index([expiresAt])
  @@map("email_tokens")
}

// Step 06 needs bidirectional exclusion; management endpoints arrive in Step 07.
model Block {
  blockerId String @map("blocker_id") @db.Uuid
  blockedId String @map("blocked_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  blocker User @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)
  @@id([blockerId, blockedId])
  @@index([blockedId, blockerId])
  @@map("blocks")
}
