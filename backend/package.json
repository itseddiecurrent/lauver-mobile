{
  "name": "lauver-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <27"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "db:generate": "prisma generate",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:render-to-supabase": "./scripts/migrate-render-to-supabase.sh",
    "db:verify:supabase": "./scripts/verify-supabase-cutover.sh",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:step-00-integration": "vitest run tests/step-00",
    "test:integration": "tsx scripts/test-integration.ts",
    "verify:step-06:staging": "tsx scripts/verify-step-06-staging.ts",
    "verify:step-07:staging": "tsx scripts/verify-step-07-staging.ts",
    "verify:step-08:staging": "tsx scripts/verify-step-08-staging.ts",
    "admin:create": "tsx scripts/create-admin.ts",
    "verify:step-13:staging": "tsx scripts/verify-step-13-staging.ts",
    "verify:step-13:moderation": "tsx scripts/verify-step-13-moderation-staging.ts",
    "reconcile:stream-memberships": "tsx scripts/reconcile-stream-memberships.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1129.0",
    "@aws-sdk/s3-request-presigner": "^3.1129.0",
    "@prisma/adapter-pg": "^6.12.0",
    "@prisma/client": "^6.12.0",
    "argon2": "^0.45.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.1.0",
    "firebase-admin": "^14.4.0",
    "helmet": "^8.3.0",
    "jose": "^6.2.10",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "sharp": "^0.35.4",
    "stream-chat": "^9.52.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^24.3.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^6.0.3",
    "eslint": "^10.9.1",
    "globals": "^17.11.0",
    "prisma": "^6.12.0",
    "supertest": "^7.1.4",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.69.0",
    "vitest": "^3.2.7"
  }
}
