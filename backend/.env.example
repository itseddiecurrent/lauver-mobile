NODE_ENV=development
HOST=0.0.0.0
PORT=3000
DATABASE_URL=postgresql://lauver:change-me@localhost:5432/lauver
CORS_ALLOWED_ORIGINS=http://localhost:3001
LOG_LEVEL=info
SHUTDOWN_TIMEOUT_MS=25000
AUTH_ACCESS_TOKEN_SECRET=replace-with-at-least-32-random-characters
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_REFRESH_TOKEN_TTL_SECONDS=2592000
AUTH_PASSWORD_RESET_TTL_SECONDS=900
AUTH_RATE_LIMIT_WINDOW_MS=60000
AUTH_RATE_LIMIT_MAX_ATTEMPTS=10
# Use `disabled` until a verified sender and provider key are configured.
PASSWORD_RESET_DELIVERY=disabled
RESEND_API_KEY=replace-with-a-resend-api-key
PASSWORD_RESET_FROM_EMAIL=noreply@example.com

# Sign in with Apple remains disabled until the App ID and server key are configured.
APPLE_AUTH_ENABLED=false
APPLE_CLIENT_ID=ai.lauver.app
APPLE_TEAM_ID=YOUR_TEAM_ID
APPLE_KEY_ID=YOUR_KEY_ID
# Store the p8 value as a Render secret. Escaped newlines are supported.
APPLE_PRIVATE_KEY=replace-with-apple-private-key
# Generate with: openssl rand -base64 32
APPLE_TOKEN_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key

# Separate Strava API application per environment. Never copy these into iOS.
STRAVA_ENABLED=false
# Uncomment after creating a Strava staging application:
# STRAVA_CLIENT_ID=12345
# STRAVA_CLIENT_SECRET=replace-with-server-side-strava-secret
# STRAVA_CALLBACK_URL=https://lauver-api-staging.onrender.com/v1/integrations/strava/callback
# Generate a dedicated key with: openssl rand -base64 32
# STRAVA_TOKEN_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key

# Profile photos stay disabled until an S3-compatible bucket/CDN is configured.
PROFILE_PHOTO_STORAGE_ENABLED=false
OBJECT_STORAGE_ENDPOINT=https://s3-compatible.example.com
OBJECT_STORAGE_REGION=auto
OBJECT_STORAGE_BUCKET=lauver-profile-photos-local
OBJECT_STORAGE_ACCESS_KEY_ID=replace-with-server-side-access-key
OBJECT_STORAGE_SECRET_ACCESS_KEY=replace-with-server-side-secret-key
OBJECT_STORAGE_PUBLIC_BASE_URL=https://photos.example.com
OBJECT_STORAGE_FORCE_PATH_STYLE=false

# Used only by `npm run test:integration`. The database name must end in `_test`
# because the test runner resets its public schema before applying all migrations.
TEST_DATABASE_URL=postgresql://lauver:change-me@localhost:5432/lauver_test

# Step 06 acceptance uses a separate ignored backend/.env.staging file.
# The staging verifier needs a connection to lauver_staging to remove only its fixtures.
# STAGING_DATABASE_URL=postgresql://.../lauver_staging
